rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'yogeeshwar.25bce8660@vitapstudent.ac.in' ||
        request.auth.token.email == 'suman.puchala2006@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users
    match /users/{uid} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Hospitals
    match /hospitals/{hospitalId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Drivers
    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Vehicles
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Pickup Requests
    match /pickupRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Waste Bags
    match /wasteBags/{bagId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // QR Events (Chain of custody - Append-only immutable log)
    match /qrEvents/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Anomalies
    match /anomalies/{anomalyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Waste Categories
    match /wasteCategories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Treatment Plants
    match /treatmentPlants/{plantId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // System Settings
    match /systemSettings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Historical Waste Stats
    match /wasteHistory/{historyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
